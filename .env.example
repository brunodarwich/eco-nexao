# API
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3001
# Use false apenas no desenvolvimento local sem HTTPS.
DJANGO_SECURE_COOKIES=false

# Supabase PostgreSQL/PostGIS (projeto econexao, sa-east-1)
# Copie a Session pooler connection string do botão "Connect" no painel.
# Nunca versione a senha real.
SUPABASE_PROJECT_REF=hjtkcmbfndbgyurfhsuo
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Esta variável seleciona o backend do Django, não o provedor do banco.
# Os modelos do domínio usam GeoDjango e exigem o backend PostGIS.
DATABASE_ENGINE=postgis

# Opcional no Windows quando as DLLs não estiverem em C:\OSGeo4W\bin.
# Informe o nome resolvível ou o caminho da biblioteca instalada.
# GDAL_LIBRARY_PATH=gdal311.dll
# GEOS_LIBRARY_PATH=geos_c.dll

# Web applications
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# URL server-side usada pelo proxy estrito do painel.
ECONEXAO_API_INTERNAL_URL=http://localhost:8000/api/v1
# Estilo público de demonstração; substitua pelo provedor contratado na homologação.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Opcional: descoberta editorial efêmera de candidatos pela Places API (New).
# Restrinja a chave à API e nunca use prefixo NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
# Desativada por padrão; exige cumprir os portões de governança antes de homologação.
GOOGLE_PLACES_ADMIN_PREVIEW_ENABLED=false
GOOGLE_PLACES_PREVIEW_RATE=10/hour

# Validação administrativa efêmera de CSV.
CSV_VALIDATION_RATE=30/hour
SUPPORT_POINT_CREATE_USER_RATE=20/hour
SUPPORT_POINT_CREATE_ORIGIN_RATE=60/hour
